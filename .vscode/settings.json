{
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  
  // ESLint configuration
  "eslint.enable": true,
  "eslint.workingDirectories": ["."],
  
  // Disable JavaScript validation completely for the workspace
  // TypeScript files will still get validation based on tsconfig.json
  "javascript.validate.enable": false,
  
  // Files to exclude from search and watching
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/.next": true,
    "**/node_modules": true,
    "**/out": true,
    "**/build": true,
    "**/dist": true
  },
  
  // Watcher exclude - improves performance
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/out/**": true,
    "**/build/**": true,
    "**/dist/**": true,
    "**/storage/**": true
  },
  
  // Search exclude
  "search.exclude": {
    "**/.next": true,
    "**/node_modules": true,
    "**/out": true,
    "**/build": true,
    "**/dist": true,
    "**/storage": true,
    "**/.git": true,
    "**/package-lock.json": true
  }
}
