{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Relax strict checking for documentation generation
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictFunctionTypes": false,
    "strictBindCallApply": false,
    "strictPropertyInitialization": false,
    "noImplicitThis": false,
    "alwaysStrict": false,
    
    // Keep these for better docs
    "skipLibCheck": true,
    "noEmit": true
  }
}
