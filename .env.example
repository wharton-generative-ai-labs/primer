# =============================================================================
# PRIMER ENVIRONMENT CONFIGURATION - EXAMPLE
# =============================================================================
# Copy this file to .env and fill in your own values
# 
# SECURITY NOTE: The .env file is git-ignored and should NEVER be committed.
# These are DEVELOPMENT-ONLY credentials for local testing.
# Production and staging environments use completely separate credentials
# managed through secure deployment platforms (e.g., Render.com, Vercel).
# =============================================================================

# -----------------------------------------------------------------------------
# Authentication - Google OAuth
# -----------------------------------------------------------------------------
# Create OAuth credentials at: https://console.cloud.google.com/apis/credentials
# For local development, set authorized redirect URI to:
#   http://localhost:3000/api/auth/callback/google
# 
# IMPORTANT: Use separate OAuth apps for dev/staging/production
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# -----------------------------------------------------------------------------
# NextAuth Configuration
# -----------------------------------------------------------------------------
# Generate a random secret with: openssl rand -base64 32
# IMPORTANT: Use different secrets for dev/staging/production
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"

# -----------------------------------------------------------------------------
# AI Provider API Keys
# -----------------------------------------------------------------------------
# OpenAI (Required) - Get from: https://platform.openai.com/api-keys
# IMPORTANT: Use separate API keys for dev/staging/production
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"

# Anthropic (Optional) - Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-api03-your-anthropic-api-key-here"

# Google AI (Optional) - Get from: https://makersuite.google.com/app/apikey
GOOGLE_AI_API_KEY="your-google-ai-api-key-here"

# -----------------------------------------------------------------------------
# User Role Mappings (Optional)
# -----------------------------------------------------------------------------
# JSON object mapping email addresses to role arrays
# Example: {"user@example.com":["ADMIN"],"other@example.com":["PLAYER"]}
# Leave empty or omit for default role assignment
USER_ROLE_MAPPINGS='{"your-email@example.com":["ADMIN"]}'

# -----------------------------------------------------------------------------
# Server Configuration (Optional)
# -----------------------------------------------------------------------------
# Socket server URL for frontend connections
# NEXT_PUBLIC_SOCKET_SERVER_URL=http://localhost:3000

# Absolute path to storage directory
# STORAGE_ROOT_PATH=/absolute/path/to/storage

# Allowed CORS origins (comma-separated, optional)
# ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Agent Configuration (Optional)
# -----------------------------------------------------------------------------
# Timeout for backend agent delegation tasks (in milliseconds)
# Default is 15 minutes (900000ms). Increase for long-running agent tasks.
# NEXT_PUBLIC_DELEGATION_TIMEOUT_MS=900000

# -----------------------------------------------------------------------------
# Module Registry (Optional)
# -----------------------------------------------------------------------------
# Comma-separated list of module registry manifest URLs.
# Primer fetches these to discover available modules for installation.
# Multiple registries are merged (first source wins on ID conflicts).
# MODULE_REGISTRY_URLS=https://raw.githubusercontent.com/wharton-generative-ai-labs/primer-modules/main/modules.json

# GitHub Personal Access Token for private module registries.
# Required if the module registry repo is private. Create a fine-grained PAT with
# Contents: Read-only permission, scoped to the primer-modules repo.
# MODULE_REGISTRY_TOKEN=github_pat_...

# -----------------------------------------------------------------------------
# Local Development Helpers (Optional)
# -----------------------------------------------------------------------------
# When set to "1" or "true", the `generateImages` tool returns stub 1x1 PNGs
# instead of calling the real image-generation provider. Useful for iterating
# on the Experience Creator's intake / design / build / handoff flow without
# paying the 5-7 minute image-generation wait. OPENAI_API_KEY must still be
# set so the tool passes its env-gate registration check (see
# src/app/lib/tools/envRequirements.ts).
# MOCK_GENERATE_IMAGES=1
